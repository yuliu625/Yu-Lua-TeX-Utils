% ---- Macros ----
%% Annotations: src/macros/annotations.tex
\definecolor{YuGreen}{named}{ForestGreen}
\NewDocumentCommand{\yu}{ m }{%
    {\color{YuGreen}[\textbf{Yu:} #1]}%
}
\NewDocumentCommand{\yuAdd}{ m }{%
    \textcolor{YuGreen}{#1}%
}
\NewDocumentCommand{\yuDelete}{ m }{%
    \textcolor{YuGreen!60}{\protect\sout{#1}}%
}
\NewDocumentCommand{\yuHighlight}{ m }{%
    {\sethlcolor{YuGreen!20}\hl{#1}}%
}
\NewDocumentCommand{\yuTodo}{ m }{%
    \fcolorbox{YuGreen}{YuGreen!10}{%
        \small\sffamily\bfseries\color{YuGreen}TODO%
        \enspace\normalfont\textcolor{YuGreen}{#1}%
    }%
}
\NewDocumentCommand{\yuNote}{ m }{%
    \todo[%
        inline,%
        color=YuGreen!10,%
        linecolor=YuGreen,%
        size=\small,%
    ]{%
        \color{YuGreen!80!black}\textbf{Yu Note:} #1%
    }%
}
%% Figures: src/macros/figures.tex
\NewDocumentCommand{\yuQuickFigure}{ O{1} m o o }{%
    % #1: size
    % #2: path
    % #3: caption
    % #4: label
    \begin{figure}[htbp]%
        \centering%
        \includegraphics[width=#1\textwidth]{#2}%
        \IfValueT{#3}{%
            \caption{#3}%
        }%
        \IfValueTF{#4}{%
            \label{#4}%
        }{%
            \label{fig-#2}%
        }%
    \end{figure}
}
\NewDocumentCommand{\yuFlexibleFigure}{ m o o }{%
    % #1: include image
    % #2: caption
    % #3: label
    \begin{figure}[htbp]%
        \centering%
        #1%
        \IfValueT{#2}{%
            \caption{#2}%
        }%
        \IfValueTF{#3}{%
            \label{#3}%
        }%
    \end{figure}
}
\keys_define:nn { yu_figure / modern_figure }
{
    % path
    path .tl_set:N = \l_yu_figure_path_tl,
    % width
    width .tl_set:N = \l_yu_figure_width_tl,
    width .initial:n = 0.8\linewidth,
    % angle
    angle .tl_set:N = \l_yu_figure_angle_tl,
    angle .initial:n = 0,
    % position
    position .tl_set:N = \l_yu_figure_position_tl,
    position .initial:n = htbp,
    % caption
    caption .tl_set:N = \l_yu_figure_caption_tl,
    caption .initial:n = { (No-Caption) },
    % label
    label .tl_set:N = \l_yu_figure_label_tl,
    label .initial:n = { },
}
\NewDocumentCommand{\yuModernFigure}{ m }
{
    \group_begin:

    \keys_set:nn { yu_figure / modern_figure } { #1 }
    \begin{figure}[\l_yu_figure_position_tl]
        \centering
        \includegraphics[
            width=\l_yu_figure_width_tl,
            angle=\l_yu_figure_angle_tl,
        ]{\l_yu_figure_path_tl}
        \caption{\l_yu_figure_caption_tl}
        \tl_if_empty:NTF \l_yu_figure_label_tl
            { \label{fig-\l_yu_figure_path_tl} }
            { \label{fig-\l_yu_figure_label_tl} }
    \end{figure}

    \group_end:
}


\ExplSyntaxOff


