\RequirePackage{soul}
\RequirePackage{todonotes}
\definecolor{YuGreen}{named}{ForestGreen}
\NewDocumentCommand{\yu}{ m }{%
    {\color{YuGreen}[\textbf{Yu:} #1]}%
}
\NewDocumentCommand{\yuAdd}{ m }{%
    \textcolor{YuGreen}{#1}%
}
\NewDocumentCommand{\yuDelete}{ m }{%
    \textcolor{YuGreen!60}{\protect\sout{#1}}%
}
\NewDocumentCommand{\yuHighlight}{ m }{%
    {\sethlcolor{YuGreen!20}\hl{#1}}%
}
\NewDocumentCommand{\yuTodo}{ m }{%
    \fcolorbox{YuGreen}{YuGreen!10}{%
        \small\sffamily\bfseries\color{YuGreen}TODO%
        \enspace\normalfont\textcolor{YuGreen}{#1}%
    }%
}
\NewDocumentCommand{\yuNote}{ m }{%
    \todo[%
        inline,%
        color=YuGreen!10,%
        linecolor=YuGreen,%
        size=\small,%
    ]{%
        \color{YuGreen!80!black}\textbf{Note: }#1%
    }%
}


